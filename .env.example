# Copy to .env at the project root; backend loads it without overriding shell env.
LLM_PROVIDER=mock
LLM_API_KEY=
# Documented Claude API ID, checked 2026-10-31. Account access is checked by API.
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_ORDERING=code
LLM_CACHE_SIZE=256
LLM_CACHE_TTL_SECONDS=300
# Optional English lexical approximation only; meaning can drift. Never ISL grammar.
ENABLE_SYNONYM_FALLBACK=false
TARGET_SIGN_LANGUAGE=ISL
INTER_SIGN_PAUSE=0.2
AVATAR_TRANSITION_SECONDS=0.18
DEMO_SIGN_DURATION=1.2
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Optional paths; use absolute paths, or paths relative to the backend process cwd.
# SIGN_DATA_PATH=/absolute/path/to/signs
# GENERATED_VIDEO_PATH=/absolute/path/to/generated
# NLTK_DATA=/absolute/path/to/nltk_data

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TRANSLATE_PER_MIN=30
RATE_LIMIT_VIDEO_PER_MIN=5
MAX_VIDEO_JOBS=2
GENERATED_TTL_MINUTES=60

# Experimental features (no model is bundled; you must hold supplied model rights)
# VITE_AVATAR_MODEL_URL=/models/your-humanoid.glb
RATE_LIMIT_FEEDBACK_PER_MIN=5
FEEDBACK_MAX_BYTES=5000000
# FEEDBACK_PATH=backend/data/feedback/reports.jsonl
